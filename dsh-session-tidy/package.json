{
  "name": "dsh-session-tidy",
  "version": "0.1.0",
  "private": true,
  "description": "工作区「…」菜单的「整理本工作区」：一键把当前工作区里已经做完、没保留价值的一次性/任务会话批量归档（排除打开中、运行中、子代理；走正式 archive，可撤销）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "session",
    "archive",
    "cleanup"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "AGENTS.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "build": {
      "manifest": "./lib/dsh-build.json",
      "inputs": [
        "src",
        "package.json",
        "scripts/build.mjs",
        "cordis.patch.yml",
        "pnpm-lock.yaml",
        "tsconfig.json",
        "tsdown.config.ts"
      ],
      "outputs": [
        "lib"
      ],
      "repositoryInputs": [
        "tooling/build.mjs",
        "tooling/build-manifest.mjs",
        "tooling/build-manifest.d.mts",
        "tooling/tsdown.mjs",
        "tooling/tsdown.d.mts",
        "tooling/tsconfig.base.json",
        "tooling/runtime/live.d.mts",
        "tooling/runtime/live.mjs",
        "tooling/tsconfig.web.json",
        "tooling/runtime/method-patch.mjs",
        "tooling/runtime/method-patch.d.mts"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1",
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  }
}
