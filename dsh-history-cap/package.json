{
  "name": "dsh-history-cap",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "在后台截短单次发给界面的历史记录，避免超大轮次让切换会话卡住",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "build": {
      "manifest": "./lib/dsh-build.json",
      "inputs": [
        "src",
        "package.json",
        "pnpm-lock.yaml",
        "scripts/build.mjs",
        "cordis.patch.yml",
        "tsconfig.json",
        "tsdown.config.mjs"
      ],
      "outputs": [
        "lib"
      ],
      "repositoryInputs": [
        "tooling/build-manifest.mjs",
        "tooling/build-manifest.d.mts",
        "tooling/build.mjs",
        "tooling/tsdown.mjs",
        "tooling/tsdown.d.mts",
        "tooling/tsconfig.base.json",
        "tooling/tsconfig.node.json"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  }
}
