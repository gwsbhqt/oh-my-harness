{
  "name": "dsh-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "让模型启动长期运行的命令，每有一行新输出就实时推进会话——盯构建、盯部署用",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "monitor",
    "stream",
    "watch",
    "jobs"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "build": {
      "manifest": "./lib/dsh-build.json",
      "inputs": [
        "src",
        "package.json",
        "scripts/build.mjs",
        "cordis.patch.yml",
        "pnpm-lock.yaml",
        "tsconfig.json",
        "tsdown.config.ts"
      ],
      "outputs": [
        "lib"
      ],
      "repositoryInputs": [
        "tooling/build.mjs",
        "tooling/build-manifest.mjs",
        "tooling/build-manifest.d.mts",
        "tooling/tsdown.mjs",
        "tooling/tsdown.d.mts",
        "tooling/tsconfig.base.json",
        "tooling/tsconfig.web.json",
        "tooling/runtime/card.d.mts",
        "tooling/runtime/card.mjs",
        "tooling/runtime/notice.mjs",
        "tooling/runtime/notice.d.mts",
        "tooling/runtime/line-reader.mjs",
        "tooling/runtime/line-reader.d.mts"
      ]
    }
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@deepseek-ai/dsh-subprocess-local",
      "koffi",
      "node-pty"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/fixtures/isolated-home.mjs --test 'test/*.test.ts'",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-jobs": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-subprocess": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cosmokit": "1.9.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-jobs-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-shell-env": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  }
}
