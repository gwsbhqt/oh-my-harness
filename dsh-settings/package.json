{
  "name": "dsh-settings",
  "version": "0.1.0",
  "private": true,
  "description": "设置包：把「模式偏好」「技能」「快捷回复」三页合成一个设置侧栏入口，三页共用草稿/撤销/保存页头；新会话按工作区选默认模式、按技能分级暴露、输入框快捷回复。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "settings",
    "presets",
    "skills",
    "quick-reply"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "AGENTS.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    },
    "build": {
      "manifest": "./lib/dsh-build.json",
      "inputs": [
        "src",
        "package.json",
        "scripts/build.mjs",
        "cordis.patch.yml",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "tsconfig.json",
        "tsdown.config.mjs",
        "tsconfig.web.json"
      ],
      "outputs": [
        "lib"
      ],
      "repositoryInputs": [
        "tooling/build-manifest.mjs",
        "tooling/build-manifest.d.mts",
        "tooling/build.mjs",
        "tooling/tsdown.mjs",
        "tooling/tsdown.d.mts",
        "tooling/tsconfig.base.json",
        "tooling/tsconfig.node.json",
        "tooling/tsconfig.web.json",
        "tooling/runtime/routes.d.mts",
        "tooling/runtime/routes.mjs",
        "tooling/runtime/preferences.d.mts",
        "tooling/runtime/preferences.mjs",
        "tooling/runtime/gateway.d.mts",
        "tooling/runtime/gateway.mjs",
        "tooling/runtime/method-patch.mjs",
        "tooling/runtime/method-patch.d.mts"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-general": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  }
}
