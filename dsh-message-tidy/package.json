{
  "name": "dsh-message-tidy",
  "version": "0.1.0",
  "private": true,
  "description": "整理系统注入对话的内容：给提醒加来源标注、后台任务按用途命名、配置变更只发差异",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "context"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "build": {
      "manifest": "./lib/dsh-build.json",
      "inputs": [
        "src",
        "package.json",
        "scripts/build.mjs",
        "cordis.patch.yml",
        "pnpm-lock.yaml",
        "tsconfig.json",
        "tsdown.config.ts"
      ],
      "outputs": [
        "lib"
      ],
      "repositoryInputs": [
        "tooling/build.mjs",
        "tooling/build-manifest.mjs",
        "tooling/build-manifest.d.mts",
        "tooling/tsdown.mjs",
        "tooling/tsdown.d.mts",
        "tooling/tsconfig.base.json",
        "tooling/tsconfig.web.json",
        "tooling/runtime/card.d.mts",
        "tooling/runtime/card.mjs",
        "tooling/runtime/fields.d.mts",
        "tooling/runtime/fields.mjs",
        "tooling/runtime/live.d.mts",
        "tooling/runtime/live.mjs",
        "tooling/runtime/notice.mjs",
        "tooling/runtime/notice.d.mts"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  }
}
