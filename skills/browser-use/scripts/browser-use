#!/usr/bin/env python3
"""browser-use 普通命令入口，与 Python 技能共用实现。"""
import os
from pathlib import Path
import sys

root = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(root / "src"))
venv = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "browser-use" / "venv"
if venv.is_dir():
    python = venv / "bin" / "python"
    # 系统 Python 升级后，旧环境里的依赖不能按新版本目录加载；让已有环境使用自己的解释器。
    if python.is_file() and Path(sys.prefix).resolve() != venv.resolve() and "install" not in sys.argv[1:]:
        os.execv(str(python), [str(python), str(Path(__file__).resolve()), *sys.argv[1:]])
    site = venv / "lib" / f"python{sys.version_info.major}.{sys.version_info.minor}" / "site-packages"
    if site.is_dir():
        sys.path.insert(1, str(site))
from browser_use.entrypoint import main

raise SystemExit(main())
