#!/usr/bin/env python3
"""computer-control 的源码启动入口。"""
import importlib.util
from pathlib import Path
import sys

entry = Path(__file__).with_name("commands.py")
if not entry.is_file():
    entry = Path(__file__).resolve().parents[1] / "src" / "computer_control" / "commands.py"
spec = importlib.util.spec_from_file_location("computer_control_commands", entry)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
raise SystemExit(module.main())
