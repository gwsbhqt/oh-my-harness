{
  "manifest_version": 3,
  "name": "browser-control test header rewrite",
  "version": "1",
  "description": "测试夹具：模拟浏览器里有别的东西改写请求头",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rewrite",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
