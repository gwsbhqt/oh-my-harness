{
  "name": "dsh-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 启动即生效的宿主钩子：把登录 shell 的环境补进宿主进程，并在保存文件时顺着链接写、把 cordis.patch.*.yml 的写法归一",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "login-shell",
    "environment",
    "symlink",
    "config"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "AGENTS.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "build": {
      "manifest": "./lib/dsh-build.json",
      "inputs": [
        "src",
        "package.json",
        "scripts/build.mjs",
        "cordis.patch.yml",
        "pnpm-lock.yaml",
        "tsconfig.json",
        "tsdown.config.mjs"
      ],
      "outputs": [
        "lib"
      ],
      "repositoryInputs": [
        "tooling/build.mjs",
        "tooling/build-manifest.mjs",
        "tooling/build-manifest.d.mts",
        "tooling/tsdown.mjs",
        "tooling/tsdown.d.mts",
        "tooling/tsconfig.base.json",
        "tooling/tsconfig.node.json"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.1",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  }
}
