{
  "agy-python-repl-session": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./hooks/session_start.py",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./hooks/session_start.py --pre-invocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(mcp_agy-python-repl_(conversation|agy-python-repl)_(run_code|kernel_state)|call_mcp_tool)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/inject_session.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(mcp_agy-python-repl_(conversation|agy-python-repl)_(run_code|kernel_state)|call_mcp_tool)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/inject_session.py --post-tool-use",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./hooks/inject_session.py --sweep-conversation",
        "timeout": 5
      }
    ]
  }
}
